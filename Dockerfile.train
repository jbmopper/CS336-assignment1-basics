# GPU Training Dockerfile with NVIDIA profiling tools (nsys, ncu)
# Requires: CUDA 12.1+ for FP8 support and latest tensor core features

FROM nvcr.io/nvidia/pytorch:24.12-py3
# PyTorch 2.5, CUDA 12.6, Python 3.12, nsys, ncu included
# Alternatives if needed:
#   24.01-py3: PyTorch 2.2, CUDA 12.3
#   23.10-py3: PyTorch 2.1, CUDA 12.2

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy project files
COPY pyproject.toml uv.lock README.md ./
COPY cs336_basics/ ./cs336_basics/
COPY benchmarks/ ./benchmarks/
COPY tests/ ./tests/

# Install dependencies (use system Python from NGC image)
RUN uv sync --frozen --python-preference system

# For profiling - allow nsys/ncu to work in container
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# Default to bash for interactive use
CMD ["bash"]
